<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <CodeCoverage>
        <ModulePaths>
            <Include>
                <ModulePath>RichardJM.*</ModulePath>
            </Include>
            <Exclude>
                <ModulePath>Microsoft.*</ModulePath>
                <ModulePath>NUnit.*</ModulePath>
            </Exclude>
        </ModulePaths>
        <Functions>
            <Exclude>
                <Function>^RichardJM.Coverlet.Tests.*</Function>
            </Exclude>
        </Functions>
    </CodeCoverage>
</Configuration>
